{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "Agent",
      "Skill",
      "TodoWrite",

      "Bash(cd:*)",
      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(which:*)",
      "Bash(mkdir -p:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git blame:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git check-ignore:*)",
      "Bash(git cat-file:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git reflog:*)",
      "Bash(git shortlog:*)",
      "Bash(git describe:*)",
      "Bash(git remote -v)",
      "Bash(git remote show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch *)",
      "Bash(git pull:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git mv *)",
      "Bash(git commit *)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git reset:*)",
      "Bash(git push:*)",

      "Bash(node --version)",
      "Bash(node --test:*)",
      "Bash(npm ci)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(docker ps:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",

      "Bash(docker compose --profile * up*)",
      "Bash(docker compose --profile * down*)",
      "Bash(docker compose * stop*)",
      "Bash(docker compose * restart*)",
      "Bash(curl -sk https://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(npx playwright cli:*)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete*)",
      "Bash(git branch -f*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git switch -f*)",
      "Bash(git switch --force*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -execdir*)",
      "Bash(find * -ok*)",
      "Bash(docker compose --profile * down*--volumes*)",
      "Bash(docker compose --profile * down* -v*)"
    ],
    "deny": [
    ]
